{
  "format": "utf-4088-registry-manifest-1",
  "status": "experimental",
  "published_symbol_count": 16606,
  "integer_id_range": [0, 16605],
  "stages": ["start", "intermediate", "final"],
  "language_tuple": ["american-english", "korean", "germanic"],
  "allocation": {
    "front_end": "exactly 16606 deterministic records",
    "remainder": "derived 4D symbol space; not predeclared as human-language characters"
  },
  "record_schema": {
    "integer_id": "uint32",
    "stage": "enum(start, intermediate, final)",
    "language": "enum(american-english, korean, germanic)",
