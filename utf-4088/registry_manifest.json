    "codepoint": "0x110000 + id",
    "shape_id": "SplitMix64(id xor 0x5348415045)",
    "meaning_id": "SplitMix64(id xor 0x4D45414E494E47)"
  },
  "validation": {
    "count": 16606,
    "unique_integer_ids": true,
    "unique_codepoints": true,
    "deterministic": true,
    "final_records_immutable_per_registry_version": true
  },
  "note": "This manifest defines an experimental deterministic registry. The generated entries are identifiers and rendering/semantic slots, not assertions that newly generated code points are established Unicode characters."
}
